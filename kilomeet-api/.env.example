# Postgres (docker compose up -d)
DATABASE_URL=postgresql://kilomeet:kilomeet@localhost:5433/kilomeet
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# fake = không gọi chain (mặc định, dùng cho test) · fuji = Avalanche Fuji testnet
CHAIN=fake
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Khoá ví OPERATOR của hợp đồng trong ../blockchain (xin người phụ trách blockchain, KHÔNG commit).
# Bên blockchain gọi là OPERATOR_PRIVATE_KEY; BE nhận cả hai tên.
SERVER_PRIVATE_KEY=
# Mnemonic sinh địa chỉ ví custodial cho từng người dùng (bỏ trống = mnemonic dev cố định)
WALLET_MNEMONIC=

# Số ngày của gói Hội viên (demo đặt dài, ví dụ 365)
MEMBERSHIP_DAYS=30
# Cho phép POST /admin/clock tua giờ (chỉ bật ở dev/demo)
ALLOW_CLOCK_OVERRIDE=true

# Địa chỉ hợp đồng: bỏ trống thì đọc file deploy của ../blockchain (đã có sẵn bản Fuji)
CHAIN_DEPLOYMENT=../blockchain/deployments/fuji.json
RUN_TOKEN_ADDRESS=
VOUCHER_ADDRESS=
BADGE_ADDRESS=
EXPLORER_URL=https://testnet.snowtrace.io
