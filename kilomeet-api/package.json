{
  "name": "kilomeet-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test:prepare": "dotenv -e .env.test -- prisma migrate deploy",
    "demo:reset": "prisma migrate reset --force",
    "demo": "tsx scripts/demo.ts",
    "demo:replay": "tsx scripts/demo.ts replay",
    "chain:check": "tsx scripts/chain-check.ts",
    "chain:set-fee": "tsx scripts/set-redeem-fee.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "ethers": "^6.17.0",
    "fastify": "^5.12.8",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "dotenv-cli": "^11.1.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
